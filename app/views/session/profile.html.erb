<%# app/views/session/profile.html.erb %>
<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-header">
          <h4 class="mb-0">
            <i class="fa fa-user-circle me-2"></i>
            Mi Perfil
          </h4>
        </div>
        
        <div class="card-body">
          <% if session[:user] %>
            <div class="text-center mb-4">
              <% if session[:user]['image_url'] %>
                <img src="<%= session[:user]['image_url'] %>" 
                     alt="<%= session[:user]['name'] %>" 
                     class="rounded-circle" 
                     style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #0066cc;">
              <% else %>
                <i class="fa fa-user-circle fa-5x text-primary"></i>
              <% end %>
            </div>
            
            <div class="table-responsive">
              <table class="table table-bordered">
                <tr>
                  <th style="width: 20%">ID:</th>
                  <td><%= session[:user]['id'] %></td>
                </tr>
                <tr>
                  <th>Nombre completo:</th>
                  <td><%= session[:user]['name'] %></td>
                </tr>
                <tr>
                  <th>Usuario:</th>
                  <td><%= session[:user]['username'] %></td>
                </tr>
                <tr>
                  <th>Email:</th>
                  <td><%= session[:user]['email'] %></td>
                </tr>
                <tr>
                  <th>Proveedor:</th>
                  <td>
                    <% if session[:user]['provider'] == 'google' %>
                      <i class="fa fa-google me-1"></i> Google
                    <% else %>
                      <%= session[:user]['provider'] %>
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Roles:</th>
                  <td>
                    <% (session[:roles] || ['user']).each do |role| %>
                      <span class="badge bg-secondary me-1"><%= role %></span>
                    <% end %>
                  </td>
                </tr>
                <tr>
                  <th>Session ID:</th>
                  <td><code><%= session.id.to_s %></code></td>
                </tr>
              </table>
            </div>
            
            <div class="alert alert-info mt-3">
              <i class="fa fa-info-circle me-2"></i>
              <strong>API Endpoint:</strong> 
              <code>/api/v1/session</code> - Datos de sesión en formato JSON
            </div>
            
            <div class="mt-3">
              <a href="/api/v1/session" class="btn btn-outline-primary" target="_blank">
                <i class="fa fa-code me-2"></i> Ver API JSON
              </a>

              <a href="/teachers/abet" class="btn btn-secondary ms-2">
                <i class="fa fa-arrow-left me-2"></i> Volver
              </a>
            </div>
            
          <% else %>
            <div class="alert alert-warning">
              <i class="fa fa-exclamation-triangle me-2"></i>
              No hay sesión activa. Por favor, inicia sesión.
            </div>
            
            <%= link_to login_path, class: "btn btn-primary" do %>
              <i class="fa fa-sign-in-alt me-2"></i> Iniciar Sesión
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>