<main class="main-content">
  <div class="container-fluid">

    <!-- Header -->
    <h3 class="mb-4">
      <a href="/admin/master-data" class="text-decoration-none">
        <i class="fa fa-cc-mastercard me-2"></i>Gestión de Datos Maestros
      </a>
      /
      Tipos de Tarea
    </h3>

    <!-- Flash Messages -->
    <% if flash[:notice] %>
      <div class="alert alert-success alert-dismissible fade show">
        <%= flash[:notice] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="alert alert-danger alert-dismissible fade show">
        <%= flash[:alert] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <!-- Filters -->
    <div class="card mb-4">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-filter me-2"></i>Filtros de búsqueda
        </h6>
      </div>

      <div class="card-body">
        <form method="GET" action="/admin/task-type" class="row g-3 align-items-end">

          <input type="hidden" name="per_page" value="<%= @pagination[:per_page] %>">

          <div class="col-md-4">
            <label class="form-label">Nombre</label>
            <input type="text"
                   name="name"
                   class="form-control"
                   placeholder="Buscar tipo de tarea..."
                   value="<%= @search_query %>">
          </div>

          <div class="col-md-4">
            <button class="btn btn-primary me-2">
              <i class="fa fa-search"></i> Buscar
            </button>

            <a href="/admin/task-type" class="btn btn-outline-secondary">
              <i class="fa fa-refresh"></i> Limpiar
            </a>
          </div>

        </form>
      </div>
    </div>

    <!-- Table Card -->
    <div class="card">

      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
          <i class="fa fa-list me-2"></i>Lista de tipos de tarea
        </h6>

        <a href="/admin/task-type/new" class="btn btn-success btn-sm">
          <i class="fa fa-plus"></i> Agregar
        </a>
      </div>

      <div class="card-body">

        <!-- Per page -->
        <div class="d-flex justify-content-between align-items-center mb-3">

          <form method="GET" action="/admin/task-type" class="d-flex align-items-center gap-2">
            <input type="hidden" name="name" value="<%= @search_query %>">

            <label class="form-label mb-0">Filas:</label>

            <select name="per_page"
                    class="form-select form-select-sm"
                    onchange="this.form.submit()"
                    style="width: 100px;">
              <% [5,10,25,50,100].each do |n| %>
                <option value="<%= n %>" <%= 'selected' if @pagination[:per_page] == n %>>
                  <%= n %>
                </option>
              <% end %>
            </select>
          </form>

          <small class="text-muted">
            Página <%= @pagination[:page] %> de <%= @pagination[:total_pages] %>
          </small>

        </div>

        <!-- Table -->
        <div class="table-responsive">
          <table class="table table-hover align-middle">

            <thead class="table-light">
              <tr>
                <th>Nombre</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>

            <tbody>
              <% if @task_types.any? %>
                <% @task_types.each do |task_type| %>
                  <tr>
                    <td><%= task_type.name %></td>

                    <td class="text-end">
                      <a href="/admin/task-type/<%= task_type.id %>/edit"
                         class="btn btn-outline-secondary">
                        <i class="fa fa-edit"></i>
                        Editar
                      </a>

                      <a href="/admin/task-type/<%= task_type.id %>/delete"
                         class="btn btn-outline-danger"
                         data-method="delete"
                         data-confirm="¿Eliminar este tipo de tarea?">
                        <i class="fa fa-trash"></i>
                        Eliminar
                      </a>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="2" class="text-center text-muted py-4">
                    No hay tipos de tarea disponibles
                  </td>
                </tr>
              <% end %>
            </tbody>

          </table>
        </div>

        <!-- Pagination -->
        <% if @pagination[:total_pages] > 1 %>
          <div class="d-flex justify-content-between align-items-center mt-3">

            <small class="text-muted">
              Mostrando <%= @pagination[:start_record] %> -
              <%= @pagination[:end_record] %> de
              <%= @pagination[:total_task_types] %>
            </small>

            <nav>
              <ul class="pagination pagination-sm mb-0">

                <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
                  <a class="page-link"
                     href="/admin/task-type?page=1&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
                    «
                  </a>
                </li>

                <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
                  <a class="page-link"
                     href="/admin/task-type?page=<%= @pagination[:page] - 1 %>&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
                    ‹
                  </a>
                </li>

                <li class="page-item active">
                  <span class="page-link">
                    <%= @pagination[:page] %>
                  </span>
                </li>

                <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
                  <a class="page-link"
                     href="/admin/task-type?page=<%= @pagination[:page] + 1 %>&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
                    ›
                  </a>
                </li>

                <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
                  <a class="page-link"
                     href="/admin/task-type?page=<%= @pagination[:total_pages] %>&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
                    »
                  </a>
                </li>

              </ul>
            </nav>

          </div>
        <% end %>

      </div>
    </div>

  </div>
</main>