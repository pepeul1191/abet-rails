<main class="main-content">
  <div class="container-fluid">
    <h3 class="mb-4">
      <a href="/admin/master-data">
        <i class="fa fa-cc-mastercard me-2"></i>Gestión de Datos Maestros
      </a> / Usuarios
    </h3>

    <%= render 'partials/flash_messages' %>

    <!-- Filtros -->
    <div class="card mb-4">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-filter me-2"></i>
          Filtros de Búsqueda
        </h6>
      </div>
      <div class="card-body">
        <form method="GET" action="/admin/user" class="row g-3">
          <input type="hidden" name="per_page" value="<%= @pagination[:per_page] %>">
          
          <div class="col-md-4">
            <label class="form-label">Buscar por Usuario o Email</label>
            <input type="text" name="search" class="form-control"
                   placeholder="Buscar por username o email..."
                   value="<%= @search_query %>">
          </div>
          
          <div class="col-md-3">
            <label class="form-label">Mostrar  <%= @status %></label>
            <select name="status" class="form-select">
              <option value="" <%= 'selected' if @status.nil? || @status == 'false' %>>Mostrar Todos</option>
              <option value="true" <%= 'selected' if @status == true || @status == 'true' %>>Usuarios Activos</option>
              <option value="false" <%= 'selected' if @status == false || @status == 'false' %>>Usuarios Inactivos</option>
            </select>
          </div>
          
          <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2">
              <i class="fa fa-search"></i> Buscar
            </button>
            <a href="/admin/user" class="btn btn-outline-secondary">
              <i class="fa fa-refresh"></i> Limpiar
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- Tabla -->
    <div class="card mb-4">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-users me-2"></i>
          Lista de Usuarios <%= @status ? '(Inactivos)' : '(Activos)' %>
        </h6>
      </div>

      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div class="d-flex align-items-center me-3">
            <label class="form-label mb-0 me-2">Filas por página:</label>
            <form method="GET" action="/admin/user" class="d-inline">
              <input type="hidden" name="search" value="<%= @search_query %>">
              <input type="hidden" name="status" value="<%= @status %>">
              <select name="per_page" class="form-select" style="width: 120px;" onchange="this.form.submit()">
                <% [5,10,25,50,100].each do |n| %>
                  <option value="<%= n %>" <%= 'selected' if @pagination[:per_page] == n %>><%= n %></option>
                <% end %>
              </select>
            </form>
          </div>

          <a href="/admin/user/new" class="btn btn-success">
            <i class="fa fa-plus"></i> Agregar Usuario
          </a>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>Username</th>
                <th>Email</th>
                <th style="text-align: center;">Imagen</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>

            <tbody>
              <% if @users.any? %>
                <% @users.each do |user| %>
                  <tr>
                    <td><strong><%= user['username'] %></strong></td>
                    <td><%= user['email'] %></td>
                    <td class="text-center">
                      <% if user['image_url'].present? %>
                        <img src="<%= user['image_url'] %>" 
                             alt="<%= user['username'] %>" 
                             style="width: 35px; height: 35px; object-fit: cover; border-radius: 50%;">
                      <% else %>
                        <i class="fa fa-user-circle fa-2x text-muted"></i>
                      <% end %>
                    </td>
                    <td>
                      <% if user['active'] %>
                        <span class="badge bg-success">Activo</span>
                      <% else %>
                        <span class="badge bg-danger">Inactivo</span>
                      <% end %>
                    </td>
                    <td class="text-end btn-group-sm">
                      <a href="/admin/user/<%= user['id'] %>/edit" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-edit"></i> Editar
                      </a>
                      <a href="/admin/user/<%= user['id'] %>/delete"
                          class="btn btn-outline-danger btn-sm"
                          data-method="delete"
                          onclick="return confirm('¿Eliminar permanentemente este usuario? Esta acción no se puede deshacer.');">
                        <i class="fa fa-trash"></i> Borrar
                      </a>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="7" class="text-center">
                    No se encontraron usuarios.
                  </td>
                </tr>
              <% end %>
            </tbody>

            <% if @pagination[:total_pages] > 1 %>
              <tfoot>
                <tr>
                  <td colspan="7">
                    <div class="d-flex justify-content-between align-items-center mt-3">
                      <div class="text-muted">
                        Página <%= @pagination[:page] %> de <%= @pagination[:total_pages] %> -
                        Mostrando <%= @pagination[:start_record] %> - <%= @pagination[:end_record] %>
                        de <%= @pagination[:total_users] %>
                      </div>

                      <ul class="pagination mb-0">
                        <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
                          <a class="page-link" href="?page=1&per_page=<%= @pagination[:per_page] %>&search=<%= @search_query %>&status=<%= @status %>">
                            « Primero
                          </a>
                        </li>
                        <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
                          <a class="page-link" href="?page=<%= @pagination[:page] - 1 %>&per_page=<%= @pagination[:per_page] %>&search=<%= @search_query %>&status=<%= @status %>">
                            ‹ Anterior
                          </a>
                        </li>
                        <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
                          <a class="page-link" href="?page=<%= @pagination[:page] + 1 %>&per_page=<%= @pagination[:per_page] %>&search=<%= @search_query %>&status=<%= @status %>">
                            Siguiente ›
                          </a>
                        </li>
                        <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
                          <a class="page-link" href="?page=<%= @pagination[:total_pages] %>&per_page=<%= @pagination[:per_page] %>&search=<%= @search_query %>&status=<%= @status %>">
                            Último »
                          </a>
                        </li>
                      </ul>
                    </div>
                  </td>
                </tr>
              </tfoot>
            <% end %>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>