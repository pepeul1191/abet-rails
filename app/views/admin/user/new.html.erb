<!-- admin/user/new.html.erb -->
<main class="main-content">
  <div class="container-fluid">
    <h3 class="mb-4">
      <a href="/admin/master-data"><i class="fa fa-cc-mastercard me-2"></i>Gestión de Datos Maestros</a> / 
      <a href="/admin/user">Usuarios</a> /
      Crear Usuario
    </h3>

    <%= render 'partials/flash_messages' %>

    <div class="card mb-4">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-edit me-2"></i>
          Datos del Usuario
        </h6>
      </div>

      <div class="card-body">
        <div class="row">

          <!-- 🖼️ IZQUIERDA: SOLO IMAGEN -->
          <div class="col-md-2 text-center">
            <label class="form-label">Foto</label>

            <div class="mb-3">
              <img id="imagePreview"
                  src="<%= @user.image_url || "#{ENV['STATIC_URL']}/img/user.png" %>"
                  style="width: 125px; height: 125px; border-radius: 0%; object-fit: cover; border: 0px solid #ddd;">
            </div>
          </div>

          <!-- 📝 DERECHA: FORMULARIO -->
          <div class="col-md-10">
            <!-- 📝 INPUT FILE -->
            <input type="file" id="imageFile" name="image_file" style="display: none;">
            <!-- 📝 FORM -->
            <form action="/admin/user" method="POST" class="row g-3">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

              <div class="col-md-6">
                <label class="form-label">Username *</label>
                <input type="text" name="user[username]" class="form-control"
                      value="<%= @user.username %>" required>
              </div>

              <div class="col-md-6">
                <label class="form-label">Email *</label>
                <input type="email" name="user[email]" class="form-control"
                      value="<%= @user.email %>" required>
              </div>

              <div class="col-md-2">
                <label class="form-label">Contraseña</label>
                <input type="password" name="user[password]" disabled class="form-control"
                      placeholder="Dejar vacío para no cambiar">
              </div>

              <div class="col-md-2">
                <label class="form-label">Confirmar Contraseña</label>
                <input type="password" name="user[password_confirmation]" disabled class="form-control">
              </div>

              <!-- 📊 Campo Active - Estado del Usuario -->
              <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select name="user[active]" class="form-select">
                  <option value="true" <%= 'selected' if @user.active == true %>>Activo</option>
                  <option value="false" <%= 'selected' if @user.active == false %>>Inactivo</option>
                </select>
                <small class="text-muted">Define si el usuario puede acceder al sistema</small>
              </div>

              <!-- 📤 CONTROLES DE IMAGEN -->
              <div class="col-md-2">
                <!-- Contenedor para el plugin de imagen -->
                <div id="fileUploadContainer">
                  <label class="form-label">Foto de Perfil</label>
                  <input type="hidden" name="user[image_url]" id="uploadedImageUrl" value="<%= @user.image_url %>">
                  <div class="d-flex gap-2 mb-2">
                    <button type="button" id="triggerFileButton" class="btn btn-outline-secondary flex-fill">
                      <i class="fa fa-folder-open me-1"></i> Buscar
                    </button>
                    <button type="button" id="uploadButton" class="btn btn-primary flex-fill">
                      <i class="fa fa-cloud-upload me-1"></i> Subir
                    </button>
                    <button type="button" id="viewImageButton" class="btn btn-info flex-fill d-none">
                      <i class="fa fa-eye me-1"></i> Ver
                    </button>
                  </div>

                  <div id="fileNameDisplay" class="small text-muted"></div>
                  <div id="helpText" class="small text-muted"></div>
                  <div id="errorMessage" class="small text-danger"></div>
                  <div id="successMessage" class="small text-success"></div>
                </div>
              </div>

              <div class="col-md-3 align-items-end" style="padding-top: 32px;">
                <button type="submit" class="btn btn-primary">
                  <i class="fa fa-check"></i> Guardar Cambios
                </button>
                <a href="/admin/user" class="btn btn-secondary ms-2">
                  <i class="fa fa-eye"></i> Cancelar
                </a>
              </div>
            </form>
          </div>

        </div>
      </div>

    </div>
  </div>
</main>

<% content_for :extra_js do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Asegurar que FileUpload esté disponible globalmente
      if (typeof FileUpload === 'undefined') {
        console.error('FileUpload class not loaded!');
        return;
      }

      // Inicializar FileUpload usando los elementos existentes
      const fileUpload = new FileUpload({
        containerId: "fileUploadContainer",
        fileInputId: "imageFile",
        triggerButtonId: "triggerFileButton",
        uploadButtonId: "uploadButton",
        viewButtonId: "viewImageButton",
        errorMessageId: "errorMessage",
        successMessageId: "successMessage",
        helpTextId: "helpText",
        fileNameDisplayId: "fileNameDisplay",
        label: "Foto de perfil",
        acceptedFormats: ["jpg", "jpeg", "png"],
        maxSizeMB: 5,
        baseURL: URLS.BASE,
        url: "api/file/public",
        triggerButtonText: "Buscar imagen",
        triggerButtonIcon: "fa-folder-open",
        extraParams: {
          user_id: <%= @user&.id || 'null' %>,
          authenticity_token: "<%= form_authenticity_token %>"
        },
        onSuccess: function(response) {
          document.getElementById('uploadedImageUrl').value = response.image_url;
          // Actualizar la vista previa
          const previewImg = document.getElementById('imagePreview');
          if (previewImg && response.image_url) {
            previewImg.src = response.image_url;
          }
          if (document.getElementById('fileNameDisplay')) {
            document.getElementById('fileNameDisplay').dataset.imageUrl = response.image_url;
          }
        },
        onViewClick: function(file, imageUrl) {
          const urlToView = imageUrl || document.getElementById('uploadedImageUrl').value;
          if (urlToView) {
            window.open(urlToView, '_blank');
          } else if (file) {
            const tempUrl = URL.createObjectURL(file);
            window.open(tempUrl, '_blank');
            setTimeout(() => URL.revokeObjectURL(tempUrl), 100);
          } else {
            alert('No hay imagen para visualizar');
          }
        }
      });
      
      // Si hay una imagen existente, establecerla
      const existingImageUrl = document.getElementById('uploadedImageUrl')?.value;
      if (existingImageUrl && fileUpload.setExistingImageUrl) {
        fileUpload.setExistingImageUrl(existingImageUrl);
      }
    });
  </script>
<% end %>