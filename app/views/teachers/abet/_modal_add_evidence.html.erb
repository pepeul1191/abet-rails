<div class="modal fade" id="abetModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">
          Seleccione el tipo de evidencia
        </h5>

        <button type="button" class="btn-close" data-bs-dismiss="modal">
        </button>
      </div>

      <div class="modal-body">

        <div class="row g-3">

          <% @abet_options.each do |option| %>

            <div class="col-md-6">

              <div class="card abet-card">

                <div class="row g-0">

                  <div class="col-4">
                    <img src="<%= option[:image] %>" class="abet-image" alt="<%= option[:title] %>">
                  </div>

                  <div class="col-8">

                    <div class="card-body">

                      <div class="d-flex justify-content-between align-items-start">

                        <h6 class="mb-1">
                          <i class="fa <%= option[:icon] %> me-1"></i>
                          <%= option[:title] %>
                        </h6>

                        <a href="<%= option[:url] %>" class="btn btn-sm <%= option[:button_class] %>">
                          <i class="fa fa-plus"></i>
                        </a>

                      </div>

                      <p class="small text-muted mb-2">
                        <%= option[:description] %>
                      </p>

                      <div class="d-flex flex-wrap gap-1">

                        <% option[:tags].each do |tag| %>
                          <span class="badge bg-light text-dark border">
                            <%= tag %>
                          </span>
                          <% end %>

                      </div>

                    </div>

                  </div>

                </div>

              </div>

            </div>

            <% end %>

        </div>

      </div>

    </div>
  </div>
</div>

<% content_for :extra_css do %>
  <style>
    .abet-card {
      border: 0;
      border-radius: 0px;
      overflow: hidden;
      transition: .2s;
      box-shadow: 0 2px 12px rgba(0, 0, 0, .08);
    }

    .abet-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, .12);
    }

    .abet-image {
      width: 100%;
      height: 100%;
      min-height: 140px;
      object-fit: cover;
    }

    .abet-card .card-body {
      padding: 1rem;
    }

    .abet-card h6 {
      font-weight: 600;
      font-size: .95rem;
      margin-top: 5px;
    }

    .abet-card .badge {
      font-size: .70rem;
      padding: .35rem .55rem;
    }

    .abet-card .btn-sm {
      width: 32px;
      height: 32px;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
    }

    .btn i {
      margin-right: 0px;
    }
  </style>
  <% end %>