<h3 class="mb-4">
  <i class="fa fa-tasks me-2"></i>
  Mis Tasks
</h3>

<div class="row g-4">

  <!-- Ejercicios Colaborativos -->
  <div class="col-lg-4 col-md-6">
    <div class="card abet-card h-100">

      <div class="position-relative">
        <img src="/img/abet-colaborative.png"
             class="card-img-top"
             alt="Ejercicios Colaborativos">

        <a href="/teachers/abet/colaboratives/new"
           class="btn btn-primary btn-add"
           title="Generar Evidencias">
          <i class="fa fa-plus"></i>
        </a>
      </div>

      <div class="card-body">
        <h5 class="card-title">
          <i class="fa fa-users me-2"></i>
          Ejercicios Colaborativos
        </h5>

        <p class="text-muted small">
          Generación de evidencias de ejercicios colaborativos.
        </p>

        <div class="mb-2">
          <strong>Inputs requeridos</strong>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <span class="badge bg-light text-dark border">
            PDF de evaluaciones
          </span>

          <span class="badge bg-light text-dark border">
            CSV de alumnos
          </span>
        </div>
      </div>

    </div>
  </div>

  <!-- Trabajo Grupal -->
  <div class="col-lg-4 col-md-6">
    <div class="card abet-card h-100">

      <div class="position-relative">
        <img src="/img/abet-colaborative.png"
             class="card-img-top"
             alt="Trabajo Grupal">

        <a href="/teachers/abet/folders-evidences/new"
           class="btn btn-success btn-add"
           title="Generar Evidencias">
          <i class="fa fa-plus"></i>
        </a>
      </div>

      <div class="card-body">
        <h5 class="card-title">
          <i class="fa fa-car me-2"></i>
          Folder con Evidencias
        </h5>

        <p class="text-muted small">
          Generación de folders con evidencias.
        </p>

        <div class="mb-2">
          <strong>Inputs requeridos</strong>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <span class="badge bg-light text-dark border">
            Rúbrica Word
          </span>

          <span class="badge bg-light text-dark border">
            CSV de alumnos
          </span>
        </div>
      </div>

    </div>
  </div>

</div>

<% content_for :extra_css do %>
  <style>
    .abet-card {
      border: 0;
      border-radius: 0px;
      overflow: hidden;
      transition: all .25s ease;
      box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .abet-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 30px rgba(0,0,0,.15);
    }

    .abet-card .card-img-top {
      height: 220px;
      object-fit: cover;
    }

    .btn-add {
      position: absolute;
      top: 15px;
      right: 15px;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;

      box-shadow: 0 4px 12px rgba(13,110,253,.35);
      font-size: 1.1rem;
    }

    .card-title {
      font-weight: 600;
    }

    .badge {
      font-weight: 500;
      padding: .6rem .8rem;
    }

    a.btn-add i {
      margin-right: 0;
      margin-top: 5px;
    }
  </style>
<% end %>

<div class="card mb-4">
  <div class="card-header">
    <h6 class="mb-0">
      <i class="fa fa-filter me-2"></i>
      Filtros
    </h6>
  </div>

  <div class="card-body">
    <form method="GET" action="/teachers/abet">
      <input type="hidden" name="per_page" value="<%= @pagination[:per_page] %>">

      <div class="row mb-3 align-items-end">

        <!-- NAME -->
        <div class="col-md-3">
          <label class="form-label">Nombre</label>
          <input type="text"
                name="name"
                class="form-control"
                value="<%= @search_query %>">
        </div>

        <!-- TASK TYPE -->
        <div class="col-md-3">
          <label class="form-label">Tipo de Task</label>
          <select name="task_type_id" class="form-select">
            <option value="">Todos</option>
            <% @task_types.each do |tt| %>
              <option value="<%= tt.id %>"
                <%= "selected" if @task_type_id.to_s == tt.id.to_s %>>
                <%= tt.name %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- START DATE -->
        <div class="col-md-2">
          <label class="form-label">Desde</label>
          <input type="date"
                name="start_date"
                class="form-control"
                value="<%= @start_date %>">
        </div>

        <!-- END DATE -->
        <div class="col-md-2">
          <label class="form-label">Hasta</label>
          <input type="date"
                name="end_date"
                class="form-control"
                value="<%= @end_date %>">
        </div>

        <!-- BUTTON -->
        <div class="col-md-2">
          <button class="btn btn-primary w-100">
            <i class="fa fa-search"></i> Filtrar
          </button>
        </div>

      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h6 class="mb-0">
      <i class="fa fa-list me-2"></i>
      Lista de Tasks
    </h6>
  </div>

  <div class="card-body">

    <div class="table-responsive">
      <table class="table table-striped table-hover">

        <thead>
          <tr>
            <th>Nombre</th>
            <th>Estado</th>
            <th>Tipo</th>
            <th>Periodo</th>
            <th>Fecha</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% if @tasks.any? %>
            <% @tasks.each do |task| %>
              <tr>
                <td><%= task.name %></td>
                <td><%= task.status %></td>
                <td><%= task.task_type&.name %></td>
                <td><%= task.period&.name %></td>
                <td><%= task.created_at&.strftime('%d/%m/%Y') %></td>

                <td class="text-end">
                  <a href="/tasks/<%= task.id %>" class="btn btn-sm btn-info">
                    Ver
                  </a>

                  <a href="/tasks/<%= task.id %>/edit" class="btn btn-sm btn-warning">
                    Editar
                  </a>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center">
                No tienes tasks registradas
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>

  <% if @pagination[:total_pages] > 1 %>
    <div class="d-flex justify-content-between align-items-center mt-3">

      <div class="text-muted">
        Página <%= @pagination[:page] %> de <%= @pagination[:total_pages] %> -
        Mostrando registros <%= @pagination[:start_record] %> - <%= @pagination[:end_record] %>
        de un total de <%= @pagination[:total_tasks] %>
      </div>

      <nav aria-label="Page navigation">
        <ul class="pagination mb-0">

          <!-- FIRST -->
          <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
            <a class="page-link"
              href="/tasks?page=1&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
              <i class="fa fa-angle-double-left"></i> Primero
            </a>
          </li>

          <!-- PREVIOUS -->
          <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
            <a class="page-link"
              href="/tasks?page=<%= @pagination[:page] - 1 %>&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
              <i class="fa fa-angle-left"></i> Anterior
            </a>
          </li>

          <!-- NEXT -->
          <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
            <a class="page-link"
              href="/tasks?page=<%= @pagination[:page] + 1 %>&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
              Siguiente <i class="fa fa-angle-right"></i>
            </a>
          </li>

          <!-- LAST -->
          <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
            <a class="page-link"
              href="/tasks?page=<%= @pagination[:total_pages] %>&per_page=<%= @pagination[:per_page] %>&name=<%= @search_query %>">
              Último <i class="fa fa-angle-double-right"></i>
            </a>
          </li>

        </ul>
      </nav>

    </div>
  <% end %>
  </div>
</div>